@article{n2026elasticity,
 bibtex_show={true},
  abbr={SSRN},
  title={Anticipated Orders and the Measurement of Stock Demand Elasticity: Evidence from Scheduled Index Rebalances},
  author={Nathan, Daniel},
 abstract={The elasticity of stock demand is usually computed as a price response divided by an institutional trade. That division implicitly assumes that the institutional trade is what the price responded to. We follow a \$92 billion ETF whose required trades are fixed five trading days ahead by a mechanical and public index rule, and we observe both sides of the auction that prices them. The fund's trade is known in advance. By the closing auction, roughly ten times as much buying and selling interest has gathered around it, 9.29 basis points per basis point of scheduled demand, against 0.44 in stocks that trade in the same auctions but carry no rebalance. Those two sides nearly cancel, and the target explains only 2.1 percent of the variation in the imbalance they leave. The closing price moves with that imbalance, not mechanically with the fund's original target. Dividing the price response by different candidate measures of demand on the same observations gives values from -3.27 to 2.38.},
  dimensions={true},
  selected={true},
  url={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=7332418},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=7332418},
  pdf={Anticipated_Orders_and_Demand_Elasticity.pdf},
  year={2026}
}
@article{ns2026factorzoo,
 bibtex_show={true},
  abbr={SSRN},
  title={Anomalies on a Schedule: Month-End Liquidity Demand and the Factor Zoo},
  author={Nathan, Daniel and Suominen, Matti},
 abstract={The first principal component of daily factor returns earns 83% of its mean in a six-day window ending four days before month-end, when institutions raising cash sell their most dispensable stocks, those far below 52-week highs. Across 153 factors over 1963-2025, 47% of the average premium accrues in that window, and exposure to dispensable stocks explains 72% of cross-sectional variation in factor returns inside it against 1.0% outside. Part of what the literature counts as distinct premia is one payment for supplying month-end liquidity. When settlement shortened to T+1 in 2024, the window moved one day closer to month-end. Much of the factor zoo earns its premium on a schedule set by the demand for cash.},
  dimensions={true},
  selected={true},
  url={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6909918},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6909918},
  pdf={Anomalies_on_a_Schedule.pdf},
  year={2026},
  online={Anomalies_on_a_Schedule_Appendix.pdf},
  code={https://github.com/dannyboy990/factor-zoo-replication}
}
@article{nst2026,
 bibtex_show={true},
  abbr={SSRN},
  title={The Intramonth Momentum Cycle},
  author={Nathan, Daniel and Suominen, Matti and Tasa, Joni},
 abstract={U.S. equity momentum returns concentrate in a six-trading-day window ending four trading days before month-end. This pre-turn-of-the-month (PreTOM) window earns 63 percent of the momentum premium over 1980-2025 and all of it since 2002 (our sample mid-point). The concentration is driven by loser stocks, which face disproportionate selling pressure during the PreTOM window, as investors sell stocks to meet month-end cash obligations. Trade-level data show that seller-initiated imbalance rises among losers during PreTOM, while mutual funds facing outflows disproportionately liquidate loser positions. Settlement reforms provide corroborating evidence: the U.S. shift from T+2 to T+1 and the European shift from T+3 to T+2 each move loser stock price pressure one trading day closer to month-end. The PreTOM pattern appears in 19 developed markets. These findings identify month-end liquidity management as a substantial source of momentum returns, distinct from leading behavioral and risk-based explanations.},
  dimensions={true},
  selected={true},
  url={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6426026},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6426026},
  pdf={The_Intramonth_Momentum_Cycle.pdf},
  year={2026},
  online={The_Intramonth_Momentum_Cycle_Appendix.pdf},
  media={<a href="https://www.bloomberg.com/opinion/newsletters/2026-03-30/private-assets-are-coming-to-401-k-s">Bloomberg Opinion</a> (Matt Levine, Money Stuff), March 30, 2026; <a href="https://alphaarchitect.com/momentum-cycle/">Alpha Architect</a> (Elisabetta Basilico), July 13, 2026; <a href="https://www.institutional-money.com/content/im/emagazin/2026_3_IM/110/index.html">Institutional Money</a> (Marko Gränitz), October 5, 2026},
  code={https://github.com/dannyboy990/momentum-replication}
}
@article{bzn2025,
 bibtex_show={true},
  abbr={SSRN},
  title={When a Market Changes Hands: Dollar Funding and the Price of a Domestic Safe Asset},
  author={Ben Zeev, Nadav and Ben-Z'eev, Noam and Nathan, Daniel},
 abstract={A bill's convenience yield, a benchmark minus its yield, is credited to safety and liquidity. We show it can also reflect the dollar funding cost of foreign holders. Banks' alternative is the interbank benchmark. Foreigners funded through FX swaps pay an observable swap-implied shekel rate, which the covered-interest-parity deviation kept below the benchmark. As foreigners' share of Israel's central-bank bills grew from 9% to 46%, the bills' convenience yield rose from zero to 51 basis points. A model attributes 21-34 basis points to foreign funding. Causal tests support the mechanism, and Mexican and Japanese bill yields also track foreign funding costs.},
  dimensions={true},
  selected={true},
  url={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5272033},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5272033},
  pdf={When_a_Market_Changes_Hands.pdf},
  year={2026},
  online={When_a_Market_Changes_Hands_Appendix.pdf}
}
@article{lnw2025,
 bibtex_show={true},
  abbr={SSRN},
  title={China Walls},
  author={Lee, Tomy and Nathan, Daniel and Wang, Chaojun},
 abstract={We evaluate the enforcement of China Walls—information barriers within conglomerates. We focus on July 2018, when the SEC tightened enforcement around broker-dealer subsidiaries, and on the 25 million Israeli Shekel trades over 2018–2024. Our difference-in-differences design compares a dealer's affiliate, connected, and unrelated funds on days when the dealer likely obtained valuable information. Before July 2018, dealers share information with their affiliate and connected funds. After July 2018: the sharing ceases only with the affiliate funds; price discovery slows; trading costs fall for affiliate funds and rise for other funds. Tightly enforced walls eliminated 99.0% of affiliate funds' event-day profits.},
  dimensions={true},
  selected={true},
  url={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5027692},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5027692},
  pdf={ChinaWalls.pdf},
  year={2026},
  note={<strong>Forthcoming in the Journal of Financial Economics</strong>},
}

